{
  "name": "astro-minimal-dprint",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "astro": "astro",
    "dev": "astro dev --host",
    "build": "astro check && astro build",
    "preview": "astro build && wrangler dev --port 4321 --ip 0.0.0.0",
    "check": "astro check",
    "lint": "pnpm eslint --fix",
    "format": "dprint fmt",
    "lint:check": "eslint",
    "format:check": "dprint check",
    "dprint": "dprint"
  },
  "dependencies": {
    "astro": "5.13.3",
    "astro-icon": "^1.1.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/sitemap": "3.5.1",
    "@eslint/js": "^9.36.0",
    "@types/eslint": "^9.6.1",
    "@typescript-eslint/eslint-plugin": "^8.44.1",
    "@typescript-eslint/parser": "^8.44.1",
    "dprint": "^0.50.2",
    "eslint": "^9.36.0",
    "eslint-plugin-astro": "^1.3.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "globals": "^16.4.0",
    "sharp": "^0.34.4",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.1",
    "wrangler": "^4.38.0"
  },
  "packageManager": "pnpm@10.17.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "dprint",
      "workerd"
    ]
  }
